{
  "name": "mobile-spec-brain",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm format:check && pnpm build && pnpm --recursive run check && pnpm lint",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && pnpm --recursive run test",
    "spec-brain": "pnpm --filter @mobile-spec-brain/cli start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.1.2"
  }
}
